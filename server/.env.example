# Copy this file to .env and fill in the values.
# .env is ignored by git; this file is committed so everyone knows which
# settings exist. Never put real secrets in this file.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# Address of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173

# ---- Auth ----
# REQUIRED. Secret that signs access tokens (at least 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=

# Optional - these are the defaults
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Database (Phase 3) ----
# REQUIRED. MongoDB Atlas connection string (Atlas -> Connect -> Drivers).
# Replace <password> with your database user's password, and put the
# database name (bank_app) between ".net/" and "?", like:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bank_app?retryWrites=true&w=majority
# If the password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ---- OTP delivery ----
# console = print the code in the server log (development stub)
OTP_EMAIL_MODE=console   # console | smtp
OTP_SMS_MODE=console     # console | twilio

# Required when OTP_EMAIL_MODE=smtp (e.g. an Ethereal test inbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required when OTP_SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
