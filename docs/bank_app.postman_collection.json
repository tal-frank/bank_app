          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('error code RECIPIENT_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('RECIPIENT_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
