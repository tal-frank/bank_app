            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"+972501234567\",\n  \"otpChannel\": \"email\"\n}",
              "options": {
